{
  "name": "farm-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-art": "node scripts/sync-art.mjs",
    "predev": "npm run sync-art",
    "dev": "vite",
    "prebuild": "npm run sync-art",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run sync-art",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs",
    "promo": "node promo/make-promo.mjs",
    "package:ads": "VITE_REWARDED_ADS=1 npm run build && node scripts/package.mjs farm-web-ads.zip"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
